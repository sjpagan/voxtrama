# Copy this file to `.env` and it works as-is: nothing here needs editing
# before `docker compose up`.

# Where Voxtrama's data lives on the host: recordings, run outputs, models
# and the database. Default: ~/Voxtrama.
# Use an absolute path if you uncomment this: compose does not expand `~`.
# VOXTRAMA_DATA_DIR=/absolute/path/to/your/data

# Extra host folders Voxtrama may read from, beyond VOXTRAMA_DATA_DIR.
# Not wired into compose.yaml: mount it into the services by hand if you
# need it.
# VOXTRAMA_EXTRA_ROOTS=

# Which model size runs on this machine:
# low = small model, <=8 GB of RAM; base = medium; high = large-v3, >=32 GB.
# `voxtrama doctor` measures this machine and suggests one. It never applies
# it, because a wrong guess makes a setting look like a slow product.
# The guided setup writes this same choice to voxtrama.toml inside the
# data directory. Setting this variable overrides whatever is in that file.
# VOXTRAMA_HARDWARE_PROFILE=base

# How transcription.asr splits ASR work across this machine's own cores.
# The guided setup writes both to voxtrama.toml inside the data directory; setting either variable
# here overrides whatever is in that file.
# VOXTRAMA_CORES_PER_CHUNK=
# VOXTRAMA_PARALLEL_CHUNKS=

# Write as this uid/gid instead of the data directory's owner, for the cases
# the automatic alignment cannot see: network mounts, or a service
# account. `voxtrama doctor` prints the three identities when a write fails.
# VOXTRAMA_RUN_AS_UID=
# VOXTRAMA_RUN_AS_GID=

# The host names the app answers to. Any other Host is refused, which stops
# a website from reaching Voxtrama through DNS rebinding. Add a name here only
# if you open Voxtrama through one, for example behind your own proxy.
# VOXTRAMA_ALLOWED_HOSTS='["127.0.0.1", "localhost", "::1"]'

# The port the host publishes 8000 on (compose.yaml). The container keeps
# listening on 8000 regardless. Change this if something else on the host
# already has 8000, not to reconfigure what's inside the container.
# VOXTRAMA_HOST_PORT=8000

# The summary model server (docs/guide/model-servers.md). Without these the
# guided setup looks for Ollama on this machine, at host.docker.internal:11434,
# and writes what you pick to voxtrama.toml; set here, they override it.
# VOXTRAMA_OLLAMA_URL=http://host.docker.internal:11434
# VOXTRAMA_OLLAMA_MODEL=qwen3:4b
# For a server behind a proxy that asks for credentials: a value with a colon
# (user:password) is sent as Basic authentication, anything else as a Bearer
# token. It never appears in logs or in a job's record.
# VOXTRAMA_OLLAMA_AUTH=user:password

# Several servers a job can choose from, as JSON, in single quotes. The one
# called "default" is used unless a job picks another; this replaces
# VOXTRAMA_OLLAMA_URL and VOXTRAMA_OLLAMA_AUTH when both are set.
# VOXTRAMA_PROVIDERS='{"default": {"url": "http://host.docker.internal:11434"}, "gpu": {"url": "https://gpu.example.org", "auth": "user:password"}}'

# How long one call to the summary model may take, in seconds, before the
# step fails with a timeout.
# VOXTRAMA_PROVIDER_TIMEOUT_SECONDS=1800

# How many parts of a long transcript go to the model at the same time.
# Ollama answers them together only when it runs with OLLAMA_NUM_PARALLEL
# set to at least this number; otherwise it answers them one by one.
# VOXTRAMA_PARALLEL_WINDOWS=2
